{
  "name": "tiktok-live-music-electron",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "description": "React + Electron + TypeScript desktop app for TikTok LIVE music interactions.",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "build:electron": "tsx scripts/build-electron.ts",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:electron && npm run build:renderer",
    "start": "npm run build:electron && electron ."
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tiktok-live-connector": "^2.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
