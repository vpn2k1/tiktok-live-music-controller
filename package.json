{
  "name": "tiktok-live-music-electron",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "description": "React + Electron + TypeScript desktop app: TikTok LIVE games and music controller.",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "build:electron": "tsx scripts/build-electron.ts",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:electron && npm run build:renderer",
    "start": "npm run build:electron && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "icons": "electron scripts/make-icons.mjs",
    "test": "tsx --test tests/*.test.ts",
    "mobile:dev": "vite --config vite.mobile.config.ts --host 127.0.0.1 --port 5174",
    "mobile:build": "vite build --config vite.mobile.config.ts && cap sync",
    "mobile:android": "npm run mobile:build && cap open android",
    "mobile:ios": "npm run mobile:build && cap open ios",
    "mobile:apk": "npm run mobile:build && cd mobile/android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "tiktok-live-connector": "^2.4.3"
  },
  "devDependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
